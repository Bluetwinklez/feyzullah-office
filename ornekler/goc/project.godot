config_version=5
[application]
config/name="GÖÇ"
run/main_scene="res://sahneler/ana_menu.tscn"
[autoload]
Ayarlar="*res://autoload/Ayarlar.gd"
Olaylar="*res://autoload/Olaylar.gd"
Oyun="*res://autoload/Oyun.gd"
Kayit="*res://autoload/Kayit.gd"
[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/subwindows/embed_subwindows=true
[gui]
theme/custom="res://arayuz/tema.tres"
[rendering]
shader_compiler/shader_cache/enabled=false
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
[debug]
gdscript/warnings/enable_all_warnings=true
[input]
ileri={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
geri={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
sol={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
sag={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
kacin={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
organ_kullan={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
etkilesim={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
duraklat={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
saldir={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1)]}
